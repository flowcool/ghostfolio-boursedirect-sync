# Bitwarden personal API credentials and vault master password (ENV only).
BW_SERVER=https://vault.bitwarden.com
BW_CLIENTID=
BW_CLIENTSECRET=
BW_PASSWORD=
BW_ITEM_NAME=boursedirect.fr

# Long-lived Ghostfolio Security Token; exchanged for a bearer each run.
GHOST_HOST=
GHOST_ACCESS_TOKEN=
GHOST_ACCOUNT_ID=
BD_SOURCE_ACCOUNT_REF=
# Use the SAME volume for every service/project sharing a broker login.
# Leave empty to retain this Compose project's existing state volume.
BD_STATE_VOLUME=

# Private ISIN -> {symbol, currency} YAML, mounted read-only.
MAPPING_FILE=/config/mappings.yaml
DRY_RUN=1
CRON=
APPRISE_URLS=

# Optional existing Docker network, used with compose.ghostfolio.yaml.
GHOSTFOLIO_NETWORK=
BOURSEDIRECT_IMAGE=

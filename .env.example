# Compose selection. For folder input: compose.yaml:compose.folder.yaml
COMPOSE_FILE=compose.yaml
COMPOSE_PROJECT_NAME=bd-import
# Empty keeps the qualified Compose image. Set an exact version or digest to override.
BOURSEDIRECT_IMAGE=
# Used only with compose.ghostfolio.yaml.
GHOSTFOLIO_NETWORK=ghostfolio

# Ghostfolio origin and exactly one Ghostfolio credential.
GHOST_HOST=https://ghostfolio.example.com
GHOST_TOKEN=
GHOST_ACCESS_TOKEN=
GHOST_ACCOUNT_NAME=

# Exactly one source. Folder is available from v2.2.0.
# Folder: NOTICE_DIR=/notices and use compose.folder.yaml.
# Paperless: keep NOTICE_DIR empty and set its URL and token.
BD_ACCOUNT_REF=
NOTICE_DIR=
NOTICE_DIRECTORY=./notices
NOTICE_WAIVER_FILE=
NOTICE_WAIVER_PATH=./notice-waivers.txt
PAPERLESS_URL=
PAPERLESS_TOKEN=
PAPERLESS_DONE_TAG=ghostfolio-done

# Optional private mapping mounted at MAPPING_FILE.
MAPPING_FILE=
DRY_RUN=1
IMPORT_CREATE_FROM=
NOTICE_COVERAGE=0
TZ=Europe/Paris

# Optional persistent operator review. The private directory must already exist.
ACTIVITY_REVIEW_DIRECTORY=./review
ACTIVITY_REVIEW_FILE=
ACTIVITY_RECONCILIATION=off
CRON=
APPRISE_URLS=
APPRISE_TIMEOUT=10
LOG_LEVEL=INFO

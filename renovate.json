{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "pip_requirements",
    "npm",
    "github-actions",
    "dockerfile",
    "custom.regex"
  ],
  "ignorePaths": [
    "collector/lab/vault.Dockerfile"
  ],
  "timezone": "Europe/Zurich",
  "schedule": [
    "before 9am on Monday"
  ],
  "automerge": false,
  "rangeStrategy": "pin",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "matchManagers": [
        "pip_requirements",
        "npm"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Python minor and patch"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Collector minor and patch"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "Container base images"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": ">=3.13 <3.14"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "node"
      ],
      "allowedVersions": ">=22 <23"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "node"
      ],
      "allowedVersions": ">=20 <21"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "engines"
      ],
      "enabled": false
    },
    {
      "description": "Own image: after a stable release, bump the README pin; automerge only when required checks pass (tests/test_image_pins.py guards consistency).",
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "ghcr.io/flowcool/ghostfolio-boursedirect-sync"
      ],
      "groupName": "own image",
      "schedule": [
        "at any time"
      ],
      "automerge": true,
      "automergeType": "pr"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": false,
    "automerge": false,
    "minimumReleaseAge": "0 days",
    "schedule": [],
    "groupName": null,
    "prCreation": "immediate"
  },
  "osvVulnerabilityAlerts": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Own published image pins in the README (bumped after each stable release).",
      "managerFilePatterns": [
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "ghcr\\.io/flowcool/ghostfolio-boursedirect-sync:(?<currentValue>v\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "depNameTemplate": "ghcr.io/flowcool/ghostfolio-boursedirect-sync",
      "datasourceTemplate": "docker"
    }
  ]
}

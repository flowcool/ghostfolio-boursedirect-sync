{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "pip_requirements",
    "github-actions",
    "dockerfile",
    "custom.regex"
  ],
  "timezone": "Europe/Zurich",
  "schedule": [
    "before 9am on Monday"
  ],
  "automerge": false,
  "rangeStrategy": "pin",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Python minor and patch"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "Container base images"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Review Python image and CI updates together.",
      "matchManagers": ["dockerfile", "github-actions"],
      "matchPackageNames": ["python", "actions/python-versions"],
      "groupName": "Python runtime"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": false,
    "automerge": false,
    "minimumReleaseAge": "0 days",
    "schedule": [],
    "groupName": null,
    "prCreation": "immediate"
  },
  "osvVulnerabilityAlerts": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the SHA-verified scheduler; update both binary hashes with the version.",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG SUPERCRONIC_VERSION=(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "aptible/supercronic",
      "datasourceTemplate": "github-releases"
    }
  ]
}

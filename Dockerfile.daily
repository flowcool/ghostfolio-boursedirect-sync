FROM python:3.15.1-slim@sha256:533b0b2f9b5d46fd097091cf826f27902f1d6c3bca714b6dc74551356aa97a51
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/work
WORKDIR /opt/app
COPY requirements.txt requirements-daily.txt ./
RUN python -m pip install --no-cache-dir -r requirements-daily.txt \
    && python -m pip uninstall -y pip
COPY boursedirect_to_ghostfolio.py ./
RUN mkdir -p /work && chmod 0700 /work && chown 1000:1000 /work
WORKDIR /work
USER 1000:1000
ENTRYPOINT ["python", "/opt/app/boursedirect_to_ghostfolio.py", "daily-preview"]
CMD ["--config", "/inputs/daily.yaml", "--input-root", "/inputs", "--max-bytes", "2000000", "--max-depth", "256"]
